# Database connection (matches docker-compose.yml defaults)
DATABASE_URL="postgresql://lexiflow:lexiflow_dev_password@127.0.0.1:5432/lexiflow?schema=public"

# Server configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Authentication (use a long random string in production: openssl rand -hex 32)
JWT_SECRET="change-me-to-a-long-random-secret-in-production"
COOKIE_SECURE=false

# Optional AI enhancement (OpenAI-compatible endpoint; leave blank to disable)
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini
# AI_DAILY_LIMIT=20
