# 将此文件重命名为 deploy.yml 并配置 GitHub Repository Secrets 后即可开启自动部署：
# 需要配置的 Secrets:
#   - VPS_HOST: 云服务器公网 IP（例如 47.xxx.xxx.xxx）
#   - VPS_USER: SSH 用户名（例如 ubuntu 或 deploy）
#   - VPS_SSH_KEY: 用于免密登录服务器的私钥内容（~/.ssh/id_ed25519）
#   - VPS_PORT: SSH 端口（默认 22）

name: Deploy to VPS

on:
  push:
    branches: [main]

jobs:
  deploy:
    runs-on: ubuntu-latest
    steps:
      - name: Deploy via SSH
        uses: appleboy/ssh-action@v1.2.0
        with:
          host: ${{ secrets.VPS_HOST }}
          username: ${{ secrets.VPS_USER }}
          key: ${{ secrets.VPS_SSH_KEY }}
          port: ${{ secrets.VPS_PORT || 22 }}
          script: |
            bash /var/www/lexiflow/deploy/deploy.sh
